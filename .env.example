# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# -----------------------------------------------------------------------------
# Production Security & Session Encryption (Prompt 16 & 17)
# -----------------------------------------------------------------------------
SECRET_KEY="generate-a-strong-random-512-bit-secret-key-for-production"
PORT=5000

# -----------------------------------------------------------------------------
# Database Persistence Configuration (Prompt 11 & 16)
# Options: 'sqlite' or 'postgres'
# -----------------------------------------------------------------------------
DATABASE_TYPE="sqlite"
DATABASE_URL="sqlite:///data/inspections.db"
# If DATABASE_TYPE="postgres":
# DATABASE_URL="postgresql://defect_user:defect_secure_pass_2026@db:5432/defect_detection"
POSTGRES_USER="defect_user"
POSTGRES_PASSWORD="defect_secure_pass_2026"
POSTGRES_DB="defect_detection"
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# File Storage & Limits (Prompt 14 & 16)
# -----------------------------------------------------------------------------
MAX_UPLOAD_SIZE=10485760
MODEL_PATH="models/"
LOG_LEVEL="INFO"

# -----------------------------------------------------------------------------
# API Polish, Security & Rate Limiting (Prompt 17)
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5000"
RATE_LIMIT="20 per minute"

# -----------------------------------------------------------------------------
# Multimodal AI Vision API Scan Mode (Prompt 18)
# Provider options: 'gemini', 'openai', 'claude'
# -----------------------------------------------------------------------------
AI_VISION_PROVIDER="gemini"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
